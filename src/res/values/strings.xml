    <!-- Onboarding Step 3: Mesh Networking & Privacy Deep Dive -->
    <string name="onboarding_mesh_privacy_badge">Samm 3 / 5 • Võrgu Arhitektuur</string>
    <string name="onboarding_mesh_privacy_title">Kuidas HÕIMU Võrk ja Privaatsus Töötavad?</string>
    <string name="onboarding_mesh_privacy_subtitle">Tsentraalivaba relee, hüppelt-hüppele levik ja turvalisus</string>
    <string name="onboarding_mesh_privacy_desc">Tutvu sellega, kuidas teated liiguvad seadmest seadmesse ilma telekommunikatsiooniettevõtete või riikliku taristuta.</string>
    <string name="mesh_concept_p2p_title">Hüppelt-hüppele Levi (Store &amp; Forward)</string>
    <string name="mesh_concept_p2p_desc">Kui sihtkoht on kaugel, kannavad vahepealsed telefonid sõnumit edasi kui usaldusväärsed releed, tagades suurema leviala.</string>
    <string name="mesh_concept_zero_cloud_title">Null-Pilve Salvestus (Zero-Cloud)</string>
    <string name="mesh_concept_zero_cloud_desc">Ühtegi faili, asukohta ega sõnumit ei saadeta tsentraalsesse serverisse. Kõik andmed elavad ainult sinu seadme kohalikus mälus.</string>
    <string name="mesh_concept_ed25519_title">Asümmeetriline Krüpteering</string>
    <string name="mesh_concept_ed25519_desc">Otsesõnumid naabritega krüpteeritakse vastuvõtja avaliku võtmega – isegi releesõlmed ei näe sõnumi sisu.</string>
    <string name="mesh_concept_sybil_title">Kogukondlik Usaldusvõrk (Web-of-Trust)</string>
    <string name="mesh_concept_sybil_desc">Usaldusskoor põhineb reaalsetel silmast-silma vahetustel ja teiste sõlmede kinnitustel, kaitstes võrku rünnakute eest.</string>

    <!-- Onboarding Step 4: Initial Mesh Visibility Preferences -->
    <string name="onboarding_visibility_badge">Samm 4 / 5 • Nähtavus &amp; Raadio</string>
    <string name="onboarding_visibility_title">Määra Esialgsed Võrgu Nähtavuse Eelistused</string>
    <string name="onboarding_visibility_subtitle">Vali kuidas ja millal sinu seade raadiolaineid levitab</string>
    <string name="onboarding_visibility_desc">Saad igal hetkel lülituda stealth-režiimi või piirata asukoha täpsust, et kaitsta oma privaatsust või säästa akut.</string>
    <string name="visibility_mode_label">Võrgusõlme Nähtavusrežiim</string>
    <string name="visibility_public_title">Avalik Majakas (Avatud Koostöö)</string>
    <string name="visibility_public_desc">Sinu kutsung ja valitud oskused on nähtavad teistele lähedalasuvatele hõimlastele.</string>
    <string name="visibility_stealth_title">Relee Režiim (Stealth Helper)</string>
    <string name="visibility_stealth_desc">Aitad edastada võrgupakette, kuid ei kuuluta aktiivselt oma identiteeti ega oskusi.</string>
    <string name="visibility_listen_title">Ainult Kuulamine (Incognito)</string>
    <string name="visibility_listen_desc">Võtad vastu ainult hädaabiteateid ja kaardiuuendusi ilma raadiosignaali välja saatmata.</string>
    <string name="pref_ble_title">Bluetooth Low Energy (BLE 5.0)</string>
    <string name="pref_ble_desc">Ülimadal energiakulu, 30–80 meetrit leviala, sobib pidevaks taustal majakaks.</string>
    <string name="pref_wifi_direct_title">Wi-Fi Direct P2P</string>
    <string name="pref_wifi_direct_desc">Kiirem andmevahetus suuremate failide ja kaartide sünkroonimiseks (kuni 150m).</string>
    <string name="pref_location_precision_label">Asukohakoordinaatide Täpsus Kaardil</string>
    <string name="pref_loc_obfuscated">Hajutatud (±500m Raadius) • Soovitatav</string>
    <string name="pref_loc_exact">Täpne GPS Koordinaat</string>
    <string name="pref_loc_none">Peidetud (Ainult Raadiosignaali Kaugus)</string>
    <string name="pref_beacon_interval_label">Majaka Kuulutamise Intervall</string>
    <string name="pref_interval_balanced">Tasakaalustatud (Iga 30s)</string>
    <string name="pref_interval_powersave">Akusäästlik (Iga 120s)</string>
    <string name="pref_interval_realtime">Reaalajas (Iga 5s)</string>
    <string name="pref_sos_relay_title">Automaatne Hädaabi (SOS) Vahendamine</string>
    <string name="pref_sos_relay_desc">Edasta automaatselt kriisi- ja hädaabisõnumeid ka siis, kui telefon on unerežiimis.</string>

