# ==============================================================================
# HÕIMU Pi Bridge Secrets & Hardware Environment Configuration
# ==============================================================================
# Production path: /etc/hoimu/secret.env
# Permissions: chmod 600 /etc/hoimu/secret.env, chown root:root /etc/hoimu/secret.env
# Loaded automatically by systemd via EnvironmentFile=-/etc/hoimu/secret.env
# ==============================================================================

# MASTER AUTH TOKEN (Optional)
# In production, leave empty to strictly require dynamic device pairing tokens minted via /api/v1/pair.
# If set, this provides a fallback break-glass administrative token.
# HOIMU_AUTH_TOKEN=generate_random_64_char_hex_token_here

# PAIRING SECRET & PIN SEED
# Secret salt used to derive ephemeral pairing PINs and authenticate BLE/WiFi-Direct pairing requests.
HOIMU_PAIRING_SECRET=hoimu_sec_8f9a2b4e7c1d3e5a6b0c2d4e6f8a0b2c

# HARDWARE RADIO DEVICE INTERFACE
# Path to SPI device or UART serial device for LoRa transceiver (e.g. SX1262 / SX1276 / EByte E22)
# Examples: /dev/spidev0.0, /dev/ttyAMA0, /dev/serial0, /dev/ttyUSB0
HOIMU_LORA_DEVICE=/dev/spidev0.0

# DATABASE & CONFIG STORAGE PATHS
HOIMU_CONFIG=/etc/hoimu/config.json
HOIMU_DB=/var/lib/hoimu/sparse_map.db
HOIMU_CREDENTIALS=/var/lib/hoimu/paired_devices.json
