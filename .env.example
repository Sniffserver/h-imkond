# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_PI_BRIDGE_URL: Base URL for the Raspberry Pi Zero 2 W hardware gateway daemon.
# Defaults to http://192.168.4.1:8080 (AP mode) or http://localhost:8080 in dev.
VITE_PI_BRIDGE_URL="http://192.168.4.1:8080"

# VITE_PI_BRIDGE_CLIENT_ID: Non-secret identifier for the client app (e.g. HOIMU-MOBILE-APP).
# DO NOT put static secret tokens here! Per-device tokens are minted via /api/v1/pair and stored in device secure storage.
VITE_PI_BRIDGE_CLIENT_ID="HOIMU-CLIENT-APP"

# VITE_ENABLE_LORA_BRIDGE: Feature flag (true/false) to enable SX1262 LoRa 868MHz bridge.
VITE_ENABLE_LORA_BRIDGE="true"

# VITE_ENABLE_SOLAR_TELEMETRY: Feature flag (true/false) for MPPT/solar PV telemetry.
VITE_ENABLE_SOLAR_TELEMETRY="true"

# VITE_DEFAULT_LANGUAGE: Initial UI language (et | en). Defaults to et.
VITE_DEFAULT_LANGUAGE="et"
